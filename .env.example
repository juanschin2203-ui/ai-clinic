# ============================================================
# Rocket Coding — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# ----- Application -----
APP_NAME="Rocket Coding"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Los_Angeles

# ----- Logging -----
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ----- Database (MySQL 8) -----
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=rocket_coding
DB_USERNAME=rocket
DB_PASSWORD=change_me_in_env

# ----- Redis / Cache / Queue -----
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=30
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# ----- Mail -----
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@rocketcoding.com"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================
# AI / LLM Providers
# ============================================================

# ----- Anthropic (primary LLM) -----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_MAX_TOKENS=4096

# ----- OpenAI (secondary / fallback) -----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo
OPENAI_ORG_ID=

# ----- AWS (Textract for OCR + S3 for storage) -----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-2
AWS_BUCKET=rocket-coding-documents
AWS_TEXTRACT_REGION=us-west-2

# ============================================================
# Rocket Coding Specific
# ============================================================

# ----- Feature Flags -----
FEATURE_OCR_ENABLED=true
FEATURE_AUTOCODING_ENABLED=true
FEATURE_APPEAL_GENERATOR=true

# ----- Pricing / Billing -----
PLATFORM_FEE_MONTHLY=299
SEAT_FEE_MONTHLY=49
AUTOCODING_FEE_PER_CLAIM=1.00

# ----- PHI / Security -----
PHI_ENCRYPTION_KEY=
PHI_REDACTION_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=2555

# ----- Optional: EHR Integration Webhooks -----
EHR_WEBHOOK_SIGNING_SECRET=
EHR_WEBHOOK_ALLOWED_ORIGINS=
